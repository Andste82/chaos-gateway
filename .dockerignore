# the image build needs the Go sources, the web app's sources, the files of the deployment (host-setup.sh, update.sh, install.sh, uninstall.sh, compose.yaml, env.example) and the interception proxy's addon
*
!go.mod
!go.sum
!cmd/
!internal/
!api/embed.go
!api/openapi.yaml
!web/
web/node_modules/
web/dist/
web/src/api/generated/
web/test-results/
web/playwright-report/
!deploy/host-setup.sh
!deploy/update.sh
!deploy/install.sh
!deploy/uninstall.sh
!deploy/compose.yaml
!deploy/env.example
!deploy/chaosgw-kea-hook
!deploy/kea-start.sh
!sidecars/tls-proxy/entry.py
!sidecars/tls-proxy/chaosgw_tlsproxy/
**/__pycache__/
