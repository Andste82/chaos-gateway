{
  "name": "chaos-gateway-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "orval --config orval.config.ts",
    "prebuild": "npm run generate",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run generate",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:testbed": "playwright test --config playwright.testbed.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/vue-query": "5.104.1",
    "pinia": "4.0.3",
    "qrcode-generator": "2.0.4",
    "reka-ui": "2.10.5",
    "uplot": "1.6.32",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "jsqr": "1.4.0",
    "orval": "8.39.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
