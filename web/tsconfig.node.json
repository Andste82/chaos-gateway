{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "orval.config.ts", "playwright.config.ts", "playwright.testbed.config.ts", "e2e/**/*.ts", "e2e-testbed/**/*.ts"]
}
